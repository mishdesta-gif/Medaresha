# ==============================================================================
# MEDARESHA HOTEL — ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env.local and populate with your real Supabase credentials.
# Do NOT commit .env.local to version control.

# Application Metadata
NEXT_PUBLIC_APP_NAME="Medaresha Luxury Hotel & Residences"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_HOTEL_TIMEZONE="Africa/Addis_Ababa"
NEXT_PUBLIC_DEFAULT_CURRENCY="ETB"
NEXT_PUBLIC_DEFAULT_LOCALE="en-ET"

# Default Hotel Property ID (Matches the flagship seeded property)
NEXT_PUBLIC_DEFAULT_PROPERTY_ID="00000000-0000-0000-0000-000000000001"

# ------------------------------------------------------------------------------
# Supabase Project API Credentials
# Obtain these from: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
# 1. Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# 2. Publishable / Anon API Key (Safe for browser / client-side operations)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 3. Privileged Service Role Key (SERVER-SIDE ONLY — NEVER EXPOSE TO CLIENT CODE)
# Required for running initial administrative setup, migrations, and atomic server operations
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# Initial Administrator Setup
# ------------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL="admin@medaresha.com"
INITIAL_ADMIN_PASSWORD="ReplaceWithAStrongPassword!"
